# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored; this
# example is not, and must never carry a real token.

# Amplify is not available in af-south-1, where the API runs. See variables.tf
# for why Ireland rather than anywhere else.
aws_region  = "eu-west-1"
environment = "prod"

app_name       = "consignment-warehouse-admin"
repository_url = "https://github.com/Ideonvn/consignment-warehouse-admin"
branch_name    = "main"

# The hosted zone for consignment-warehouse.com is in this same AWS account, so
# Amplify creates and manages the DNS records itself — nothing to paste into a
# control panel. Leave empty to launch on the amplifyapp.com domain first.
# This origin is already in the API's CORS_ALLOWED_ORIGINS; see terraform/README.md.
app_domain = "admin.consignment-warehouse.com"

# The production API. Note https and wss — the localhost values in .env.example
# are for development only, and a ws:// socket from an https page is blocked.
api_base_url = "https://api.consignment-warehouse.com/api/v1"
ws_url       = "wss://api.consignment-warehouse.com/api/v1/ws"
