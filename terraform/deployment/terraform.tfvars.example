# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored; this
# example is not, and must never carry a real token.

# Amplify is not available in af-south-1, where the API runs. See variables.tf
# for why Ireland rather than anywhere else.
aws_region  = "eu-west-1"
environment = "prod"

app_name       = "consignment-warehouse-admin"
repository_url = "https://github.com/your-org/consignment-warehouse-admin"
branch_name    = "main"

# Required for a private repository: `repo` and `admin:repo_hook` scopes.
# Leave empty to connect the repository by hand in the console instead — the
# token then never enters Terraform state.
github_access_token = ""

# Leave empty to launch on the amplifyapp.com domain first and cut DNS over
# later. Whatever this becomes must be added to the API's CORS_ALLOWED_ORIGINS.
app_domain = "admin.example.co.za"

# The production API. Note https and wss — the localhost values in .env.example
# are for development only, and a ws:// socket from an https page is blocked.
api_base_url = "https://api.example.co.za/api/v1"
ws_url       = "wss://api.example.co.za/api/v1/ws"
